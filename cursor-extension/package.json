{
  "name": "unreal-cursor-integration",
  "displayName": "Unreal Engine Cursor Integration",
  "description": "Deep Unreal Engine Editor integration for Cursor",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Asgardian/Unreal-Cursor-Integration.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.uproject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "unreal",
          "title": "Unreal Engine",
          "icon": "media/icons/unreal.svg"
        }
      ]
    },
    "views": {
      "unreal": [
        {
          "id": "unrealToolbarView",
          "name": "Toolbar",
          "when": "true"
        },
        {
          "id": "unrealTreeView",
          "name": "Unreal Engine",
          "when": "true"
        },
        {
          "id": "unrealBuildView",
          "name": "Build Tools",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "unreal.connect",
        "title": "Connect",
        "icon": "$(plug)"
      },
      {
        "command": "unreal.disconnect",
        "title": "Disconnect",
        "icon": "$(plug)"
      },
      {
        "command": "unreal.build.editor",
        "title": "Build Editor",
        "icon": "$(tools)"
      },
      {
        "command": "unreal.build.game",
        "title": "Build Game",
        "icon": "$(tools)"
      },
      {
        "command": "unreal.build.clean",
        "title": "Clean",
        "icon": "$(trash)"
      },
      {
        "command": "unreal.project.generateFiles",
        "title": "Generate Project Files",
        "icon": "$(file-code)"
      },
      {
        "command": "unreal.intellisense.generateCompileCommands",
        "title": "Generate compile_commands.json",
        "icon": "$(code)"
      },
      {
        "command": "unreal.intellisense.runUHTCheck",
        "title": "Run UHT Check",
        "icon": "$(check)"
      },
      {
        "command": "unreal.liveCoding.compile",
        "title": "Compile (Live Coding)",
        "icon": "$(sync)"
      },
      {
        "command": "unreal.liveCoding.toggle",
        "title": "Toggle Live Coding",
        "icon": "$(sync)"
      },
      {
        "command": "unreal.liveCoding.restart",
        "title": "Restart Live Coding",
        "icon": "$(refresh)"
      },
      {
        "command": "unreal.run.playPIE",
        "title": "Play In Editor",
        "icon": "$(play)"
      },
      {
        "command": "unreal.run.stopPIE",
        "title": "Stop PIE",
        "icon": "$(stop)"
      },
      {
        "command": "unreal.run.pausePIE",
        "title": "Pause PIE",
        "icon": "$(debug-pause)"
      },
      {
        "command": "unreal.project.refresh",
        "title": "Refresh Solution",
        "icon": "$(refresh)"
      },
      {
        "command": "unreal.run.standalone",
        "title": "Run Standalone",
        "icon": "$(terminal)"
      },
      {
        "command": "unreal.logs.open",
        "title": "Open Logs View",
        "icon": "$(output)"
      },
      {
        "command": "unreal.logs.clear",
        "title": "Clear Logs",
        "icon": "$(clear-all)"
      },
      {
        "command": "unreal.logs.setFilter",
        "title": "Set Log Filter",
        "icon": "$(filter)"
      },
      {
        "command": "unreal.logs.exportJson",
        "title": "Export Logs to JSON",
        "icon": "$(export)"
      },
      {
        "command": "unreal.profiling.start",
        "title": "Start Profiling",
        "icon": "$(graph)"
      },
      {
        "command": "unreal.profiling.stop",
        "title": "Stop Profiling",
        "icon": "$(graph)"
      },
      {
        "command": "unreal.profiling.openDashboard",
        "title": "Open Performance Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "unreal.profiling.exportSession",
        "title": "Export Profiling Session",
        "icon": "$(export)"
      },
      {
        "command": "unreal.blueprints.exportGraphJson",
        "title": "Export Blueprint Graph to JSON",
        "icon": "$(export)"
      },
      {
        "command": "unreal.settings.open",
        "title": "Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "unreal.testConnection",
        "title": "Test Connection",
        "icon": "$(debug-console)"
      },
      {
        "command": "unreal.testHover",
        "title": "Test Hover Provider",
        "icon": "$(info)"
      },
      {
        "command": "unreal.build.cancel",
        "title": "Cancel Build",
        "icon": "$(stop-circle)"
      },
      {
        "command": "unreal.build.listTargets",
        "title": "List Build Targets",
        "icon": "$(list-unordered)"
      },
      {
        "command": "unreal.editor.launch",
        "title": "Launch Unreal Editor",
        "icon": "$(rocket)"
      },
      {
        "command": "unreal.build.openView",
        "title": "Open Build Tools",
        "icon": "$(tools)"
      },
      {
        "command": "unreal.build.rebuild",
        "title": "Rebuild",
        "icon": "$(sync)"
      },
      {
        "command": "unreal.debug.start",
        "title": "Start Debugging",
        "icon": "$(debug-start)"
      },
      {
        "command": "unreal.logs.subscribe",
        "title": "Subscribe to Logs",
        "icon": "$(output)"
      },
      {
        "command": "unreal.logs.unsubscribe",
        "title": "Unsubscribe from Logs",
        "icon": "$(output)"
      },
      {
        "command": "unreal.paths.configure",
        "title": "Configure Unreal Engine Paths",
        "icon": "$(settings-gear)"
      },
      {
        "command": "unreal.planning.validate",
        "title": "Unreal: Validate Plan",
        "category": "Unreal",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "unreal.editor.launch",
          "when": "true"
        },
        {
          "command": "unreal.build.editor",
          "when": "unreal.connected"
        },
        {
          "command": "unreal.build.rebuild",
          "when": "unreal.connected"
        },
        {
          "command": "unreal.build.clean",
          "when": "unreal.connected"
        },
        {
          "command": "unreal.liveCoding.compile",
          "when": "unreal.connected && unreal.capabilities.liveCoding"
        },
        {
          "command": "unreal.run.playPIE",
          "when": "unreal.connected"
        },
        {
          "command": "unreal.debug.start",
          "when": "unreal.connected"
        }
      ],
      "view/item/context": [
        {
          "command": "unreal.connect",
          "when": "view == unrealTreeView && viewItem == connectionItem",
          "group": "inline"
        },
        {
          "command": "unreal.build.editor",
          "when": "view == unrealTreeView && viewItem == buildItem",
          "group": "inline"
        },
        {
          "command": "unreal.liveCoding.compile",
          "when": "view == unrealTreeView && viewItem == liveCodingItem && unreal.capabilities.liveCoding",
          "group": "inline"
        },
        {
          "command": "unreal.run.playPIE",
          "when": "view == unrealTreeView && viewItem == runItem",
          "group": "inline"
        },
        {
          "command": "unreal.logs.open",
          "when": "view == unrealTreeView && viewItem == logsItem",
          "group": "inline"
        },
        {
          "command": "unreal.profiling.start",
          "when": "view == unrealTreeView && viewItem == profilingItem",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Unreal Engine Integration",
      "properties": {
        "unreal.port": {
          "type": "number",
          "default": 17777,
          "description": "WebSocket port for Unreal Engine plugin connection"
        },
        "unreal.authToken": {
          "type": "string",
          "default": "",
          "description": "Optional authentication token (leave empty to disable)"
        },
        "unreal.autoConnect": {
          "type": "boolean",
          "default": false,
          "description": "Automatically connect when workspace opens"
        },
        "unreal.logLevel": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Logging level for extension output"
        },
        "unreal.intellisense.autoRegenerate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically regenerate compile_commands.json when C++ files are added or modified"
        },
        "unreal.intellisense.autoUHTCheck": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run UHT check when C++ files are added or modified to detect Unreal errors in real-time"
        },
        "unreal.engineRoot": {
          "type": "string",
          "default": "",
          "description": "Manual override: Path to Unreal Engine root directory (e.g., C:\\Program Files\\Epic Games\\UE_5.6\\Engine). Leave empty for auto-detection."
        },
        "unreal.buildToolPath": {
          "type": "string",
          "default": "",
          "description": "Manual override: Path to UnrealBuildTool executable. Leave empty for auto-detection."
        },
        "unreal.editorPath": {
          "type": "string",
          "default": "",
          "description": "Manual override: Path to UnrealEditor executable. Leave empty for auto-detection."
        },
        "unreal.planning.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Unreal Planning Validator for this workspace. Only works with Unreal Engine projects.",
          "scope": "resource"
        },
        "unreal.planning.maxIterations": {
          "type": "number",
          "default": 5,
          "description": "Maximum validation iterations",
          "scope": "resource"
        },
        "unreal.hover.showErrors": {
          "type": "boolean",
          "default": false,
          "description": "Show error notifications when hover provider fails (useful for debugging)",
          "scope": "resource"
        },
        "unreal.intellisense.standaloneMode": {
          "type": "boolean",
          "default": true,
          "description": "Enable standalone mode for UHT and IntelliSense (works without Unreal Editor running). When enabled, automatically falls back to standalone mode if editor is not connected.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "package:npm": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "webpack": "^5.88.0"
  },
  "dependencies": {
    "uuid": "^9.0.0",
    "ws": "^8.14.0"
  }
}
